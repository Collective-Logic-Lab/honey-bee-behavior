# Local Python environments and caches
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Local configuration and stop files
.env
.env.*
.safeword

# OS/editor noise
.DS_Store

# Large generated pipeline outputs.
#
# `data/raw/` and `data/experiments/` may contain small permanent seed files,
# so they are not blanket-ignored here. Be careful before adding large source
# videos or full rendered outputs.
data/raw/**/*.part
data/raw/**/*.tmp
data/raw/**/.DS_Store

# Always keep our pet sample videos
!data/raw/start04_sample_5s.mp4

data/qc/**
!data/qc/
!data/qc/.gitkeep
!data/qc/README.md

data/artifacts/**
!data/artifacts/
!data/artifacts/.gitkeep
!data/artifacts/README.md

data/experiments/**/*_parts/
data/experiments/**/*.part
data/experiments/**/*.tmp
data/experiments/**/.DS_Store

# Always keep our pet experiment
!data/experiment_sample_5s
